{
  "name": "omp-session-roles",
  "version": "0.1.0",
  "description": "Session-scoped model role overrides for Oh My Pi (omp): /roles panel, per-session subagent routing, never writes config files.",
  "type": "module",
  "license": "MIT",
  "repository": "github:elian37/omp-session-roles",
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "bun test test/",
    "test:core": "bun test core-patch/tests/",
    "check": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "e2e": "bun e2e/scenario.ts",
    "e2e:panel": "bun e2e/panel-rpc.ts",
    "e2e:install": "bun e2e/install-check.ts",
    "e2e:patched": "pwsh -NoProfile -File e2e/patched-install.ps1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-coding-agent": "18.12.3",
    "@oh-my-pi/pi-tui": "18.12.3",
    "@types/bun": "^1.4.3",
    "typescript": "5"
  }
}
